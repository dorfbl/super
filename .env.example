# --- WhatsApp ---
# Comma-separated list of WhatsApp JIDs allowed to talk to the bot.
# JID format: <country-code><number>@s.whatsapp.net  (no '+', no spaces)
# Israeli example: 9725XXXXXXXX@s.whatsapp.net
# Tip: send a message from each phone to a chat you control, then in
# Baileys logs you'll see the JID. Or compute it from the international
# number (drop the leading '+').
WHATSAPP_GROUP_JIDS=XXXXXXXXXXXXXXXXXXXXXXXX@g.us

# Where Baileys stores its session.
# Local dev:  ./auth
# Fly.io:     /data/auth   (mounted persistent volume — see fly.toml)
AUTH_DIR=./auth

# --- Supabase ---
# Create a free project at supabase.com, then SQL Editor -> paste schema.sql -> Run.
# Project Settings -> API:
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# Use the SERVICE ROLE key (bypasses RLS — fine for a single-tenant bot).
SUPABASE_SERVICE_KEY=eyJhb.......

# --- Anthropic ---
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant............
